# Normalize text sources to LF across Windows, macOS, and Linux
* text=auto eol=lf

*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.qml text eol=lf
*.ts text eol=lf
*.svg text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf

# Windows batch and PowerShell scripts
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.ico binary
*.icns binary
*.ttf binary
*.woff2 binary
*.qm binary
*.db binary
*.zip binary
